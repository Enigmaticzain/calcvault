         1. TWILIGHT STARGAZING
         Under our infinity sky - Purple dusk
         ======================================== -->
    
    <style name="CalcVaultTheme.Sanctuary.StargazingDark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Background -->
        <item name="android:windowBackground">@color/cv_sanctuary_stargazing_bg</item>
        <item name="android:statusBarColor">@color/cv_sanctuary_stargazing_bg</item>
        <item name="android:navigationBarColor">@color/cv_sanctuary_stargazing_bg</item>
        
        <!-- Colors -->
        <item name="colorPrimary">@color/cv_sanctuary_stargazing_accent</item>
        <item name="colorPrimaryDark">@color/cv_sanctuary_stargazing_accent_dark</item>
        <item name="colorAccent">@color/cv_sanctuary_stargazing_accent</item>
        
        <!-- Surface & Text -->
        <item name="android:textColorPrimary">@color/cv_sanctuary_stargazing_text_primary</item>
        <item name="android:textColorSecondary">@color/cv_sanctuary_stargazing_text_secondary</item>
    </style>

