<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================================
         PRIMARY THEME
         ======================================== -->
    <style name="CalcVaultTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#1C1C1E</item>
        <item name="android:statusBarColor">#1C1C1E</item>
        <item name="android:navigationBarColor">#1C1C1E</item>
        <item name="colorPrimary">#FF9F0A</item>
        <item name="colorPrimaryDark">#FF9F0A</item>
        <item name="colorAccent">#FF9F0A</item>
    </style>

    <!-- ========================================
         TEXT STYLES
         ======================================== -->
    
    <!-- Display Text -->
    <style name="TextDisplayLarge">
        <item name="android:textSize">@dimen/cv_text_display_lg</item>
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>
    
    <style name="TextDisplayMedium">
        <item name="android:textSize">@dimen/cv_text_display_md</item>
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    
    <style name="TextHeadlineLarge">
        <item name="android:textSize">@dimen/cv_text_headline_lg</item>
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    
    <!-- Title Text -->
    <style name="TextTitleLarge">
        <item name="android:textSize">@dimen/cv_text_title_lg</item>
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextTitleMedium">
        <item name="android:textSize">@dimen/cv_text_title_md</item>
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Body Text -->
    <style name="TextBodyLarge">
        <item name="android:textSize">@dimen/cv_text_body_lg</item>
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>
    
    <style name="TextBodyMedium">
        <item name="android:textSize">@dimen/cv_text_body_md</item>
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <style name="TextBodySmall">
        <item name="android:textSize">@dimen/cv_text_body_sm</item>
        <item name="android:textColor">@color/cv_text_secondary_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <!-- Label Text -->
    <style name="TextLabelMedium">
        <item name="android:textSize">@dimen/cv_text_label_md</item>
        <item name="android:textColor">@color/cv_text_tertiary_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextLabelSmall">
        <item name="android:textSize">@dimen/cv_text_label_sm</item>
        <item name="android:textColor">@color/cv_text_tertiary_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <!-- Caption -->
    <style name="TextCaption">
        <item name="android:textSize">@dimen/cv_text_caption</item>
        <item name="android:textColor">@color/cv_text_quaternary_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ========================================
         BUTTON STYLES
         ======================================== -->
    
    <!-- Primary Button -->
    <style name="ButtonPrimary">
        <item name="android:textColor">@color/cv_button_primary_text</item>
        <item name="android:textSize">@dimen/cv_text_body_md</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/bg_vault_chip</item>
        <item name="android:padding">@dimen/cv_space_md</item>
        <item name="android:elevation">@dimen/cv_elevation_md</item>
    </style>
    
    <!-- Accent Button -->
    <style name="ButtonAccent">
        <item name="android:textColor">@color/cv_button_primary_text</item>
        <item name="android:textSize">@dimen/cv_text_body_md</item>
        <item name="android:background">@drawable/bg_vault_chip</item>
        <item name="android:padding">@dimen/cv_space_md</item>
        <item name="android:elevation">@dimen/cv_elevation_md</item>
    </style>
    
    <!-- Secondary Button -->
    <style name="ButtonSecondary">
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:textSize">@dimen/cv_text_body_md</item>
        <item name="android:background">@drawable/bg_vault_input_bar</item>
        <item name="android:padding">@dimen/cv_space_md</item>
        <item name="android:elevation">@dimen/cv_elevation_none</item>
    </style>
    
    <!-- Text Button -->
    <style name="ButtonText">
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:textSize">@dimen/cv_text_body_md</item>
        <item name="android:elevation">@dimen/cv_elevation_none</item>
        <item name="android:background">@drawable/bg_vault_panel</item>
    </style>

    <!-- ========================================
         INPUT FIELD STYLES
         ======================================== -->
    
    <style name="InputFieldVault">
        <item name="android:background">@drawable/bg_edittext_vault</item>
        <item name="android:textColor">@color/cv_text_primary_dark</item>
        <item name="android:textColorHint">@color/cv_text_tertiary_dark</item>
        <item name="android:textSize">@dimen/cv_text_body_md</item>
        <item name="android:paddingStart">@dimen/cv_space_lg</item>
        <item name="android:paddingEnd">@dimen/cv_space_lg</item>
        <item name="android:paddingTop">@dimen/cv_space_md</item>
        <item name="android:paddingBottom">@dimen/cv_space_md</item>
        <item name="android:minHeight">@dimen/cv_button_height_lg</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ========================================
         CALCULATOR BUTTON STYLES
         ======================================== -->

    <style name="CalcBtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:minHeight">80dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:background">@drawable/bg_vault_chip</item>
    </style>

    <style name="CalcBtnNumber" parent="CalcBtnBase">
        <item name="android:backgroundTint">@color/calc_btn_number</item>
        <item name="android:textColor">@color/calc_text</item>
    </style>

    <style name="CalcBtnFunction" parent="CalcBtnBase">
        <item name="android:backgroundTint">@color/calc_btn_function</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="CalcBtnOperator" parent="CalcBtnBase">
        <item name="android:backgroundTint">@color/calc_btn_operator</item>
        <item name="android:textColor">@color/calc_text</item>
    </style>

    <style name="CalcBtnEquals" parent="CalcBtnBase">
        <item name="android:backgroundTint">@color/calc_btn_operator</item>
        <item name="android:textColor">@color/calc_text</item>
    </style>

    <!-- ========================================
         CARD & PANEL STYLES
         ======================================== -->
    
    <style name="CardVaultElevated">
        <item name="android:background">@color/cv_surface_overlay_strong</item>
        <item name="android:elevation">@dimen/cv_elevation_md</item>
        <item name="android:padding">@dimen/cv_space_md</item>
    </style>
    
    <style name="CardVault">
        <item name="android:background">@color/cv_surface_overlay</item>
        <item name="android:elevation">@dimen/cv_elevation_none</item>
        <item name="android:padding">@dimen/cv_space_md</item>
    </style>
    
    <style name="PanelVaultSoft">
        <item name="android:background">@drawable/bg_vault_panel_soft</item>
        <item name="android:padding">@dimen/cv_space_xl</item>
    </style>

    <!-- ========================================
         FAB STYLES
         ======================================== -->
    
    <style name="FABVault" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="elevation">@dimen/cv_elevation_lg</item>
        <item name="fabCustomSize">@dimen/cv_fab_md</item>
        <item name="borderWidth">0dp</item>
        <item name="tint">@color/cv_button_primary_text</item>
    </style>

    <!-- ========================================
         UTILITY STYLES
         ======================================== -->
    
    <style name="Theme.MaterialComponents.Translucent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

</resources>
