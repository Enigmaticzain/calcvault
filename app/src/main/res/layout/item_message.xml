<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/cv_space_md"
    android:paddingVertical="@dimen/cv_space_xs">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        app:cardBackgroundColor="@color/cv_recv_bubble_dark"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/cv_surface_outline"
        app:strokeWidth="0dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="280dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cv_space_lg"
            android:paddingVertical="@dimen/cv_space_md"
            android:minWidth="80dp">

            <TextView
                android:id="@+id/tvMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cv_text_primary_dark"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp"
                android:breakStrategy="balanced" />

            <ImageView
                android:id="@+id/ivGif"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieGiftView"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:visibility="gone"
                app:lottie_autoPlay="false"
                app:lottie_loop="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cv_text_tertiary_dark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cv_accent"
                    android:textSize="11sp"
                    android:layout_marginStart="@dimen/cv_space_xs"
                    android:text="" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/reactionsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="-8dp"
        android:layout_marginStart="@dimen/cv_space_md"
        android:paddingHorizontal="@dimen/cv_space_sm"
        android:paddingVertical="3dp"
        android:background="@drawable/bg_reactions_pill"
        android:elevation="2dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardBubble"
        app:layout_constraintStart_toStartOf="@id/cardBubble" />

</androidx.constraintlayout.widget.ConstraintLayout>
