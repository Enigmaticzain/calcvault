<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shareRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/pauseOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#AA000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Sharing paused"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/remoteContainer"
        android:layout_width="260dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="20dp"
        android:background="#CC141414"
        android:elevation="8dp"
        android:visibility="gone">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/remoteVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:gravity="end"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/btnMinimizeRemote"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="−"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCloseRemote"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:text="×"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/eyesIndicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="160dp"
        android:background="#AA121212"
        android:gravity="center"
        android:padding="8dp"
        android:text="👀"
        android:textSize="24sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/eyesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginTop="220dp"
        android:background="#AA121212"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="Your partner is watching"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Connecting..."
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnPauseShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause" />

        <Button
            android:id="@+id/btnResumeShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Resume"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEndShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/cv_danger"
            android:text="Stop"
            android:textColor="@android:color/white" />
    </LinearLayout>

</FrameLayout>
