<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/houseContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3E8F6">

    <io.github.sceneview.SceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3E8F6" />

    <LinearLayout
        android:id="@+id/roomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/houseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tom + Angela Home"
            android:textColor="#2B2431"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Zain controls Tom • Sanu controls Angela"
            android:textColor="#6B6072"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:id="@+id/roomScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="always"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_living"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="112dp"
                    android:text="🛋️ Living"
                    android:textAllCaps="false"
                    android:textColor="#2B2431"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_kitchen"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="112dp"
                    android:text="🍳 Kitchen"
                    android:textAllCaps="false"
                    android:textColor="#2B2431"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_bedroom"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="112dp"
                    android:text="🛏️ Bedroom"
                    android:textAllCaps="false"
                    android:textColor="#2B2431"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_activity"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="112dp"
                    android:text="🎮 Playroom"
                    android:textAllCaps="false"
                    android:textColor="#2B2431"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_bathroom"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="112dp"
                    android:text="🚿 Bathroom"
                    android:textAllCaps="false"
                    android:textColor="#2B2431"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_garden"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="112dp"
                    android:text="🌿 Garden"
                    android:textAllCaps="false"
                    android:textColor="#2B2431"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/commandsPanel"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:layout_gravity="bottom"
        android:clipToPadding="false"
        android:fadingEdgeLength="28dp"
        android:overScrollMode="always"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/petStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap your pet controls. Drag either character around the shared room."
                android:textColor="#3C3344"
                android:textSize="13sp" />

            <!-- Care Actions Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/cmd_feed_tom"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="96dp"
                        android:text="🍽 Feed Tom"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/cmd_feed_angela"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="96dp"
                        android:text="🍽 Feed Angela"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/cmd_bathe"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="96dp"
                        android:text="🛁 Bathe"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/cmd_sleep"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="96dp"
                        android:text="😴 Sleep"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/cmd_minigame"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="96dp"
                        android:text="🎮 Mini-Games"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Interaction Commands Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:overScrollMode="always"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/cmd_cook"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="112dp"
                        android:text="Cook 🍳"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/cmd_watch"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="112dp"
                        android:text="Watch 📺"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/cmd_play"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="112dp"
                        android:text="Play 🎮"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/cmd_relax"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="112dp"
                        android:text="Relax 🧘"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/tomPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tom controls — Zain"
                    android:textColor="#2B2431"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_tom_idle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Idle"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_tom_listen"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Listen"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_tom_talk"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Talk"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/angelaPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Angela controls — Sanu"
                    android:textColor="#2B2431"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_angela_idle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Idle"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_angela_listen"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Listen"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_angela_talk"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Talk"
                        android:textAllCaps="false"
                        android:textColor="#2B2431"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:overScrollMode="always"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/mood_happy"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="😊"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/mood_romantic"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="😍"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/mood_playful"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="😄"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/mood_tired"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="😴"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/mood_sad"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="😔"
                        android:textSize="20sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/infoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Dynamic scroll panels keep controls readable."
                android:textColor="#6B6072"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
