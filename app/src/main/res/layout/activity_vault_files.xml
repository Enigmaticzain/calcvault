<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vault_screen">

    <!-- Header Panel -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cv_space_lg"
        android:layout_marginTop="@dimen/cv_space_lg"
        android:layout_marginEnd="@dimen/cv_space_lg"
        android:background="@drawable/bg_vault_panel_soft"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/cv_space_2xl"
        android:paddingTop="44dp"
        android:paddingBottom="@dimen/cv_space_xl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title -->
        <TextView
            style="@style/TextHeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vault_storage_title"
            android:textColor="@color/cv_text_primary_dark" />

        <!-- File Count -->
        <TextView
            android:id="@+id/tvFileCount"
            style="@style/TextBodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vault_files_empty"
            android:textColor="@color/cv_text_secondary_dark"
            android:layout_marginTop="@dimen/cv_space_xs" />
    </LinearLayout>

    <!-- Files Container Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/cv_space_lg"
        android:layout_marginTop="@dimen/cv_space_lg"
        android:layout_marginEnd="@dimen/cv_space_lg"
        android:layout_marginBottom="@dimen/cv_space_lg"
        app:cardBackgroundColor="@color/cv_surface_overlay"
        app:cardCornerRadius="@dimen/cv_radius_xl"
        app:cardElevation="@dimen/cv_elevation_none"
        app:strokeColor="@color/cv_surface_outline"
        app:strokeWidth="@dimen/cv_stroke_thin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Files RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/cv_space_sm"
            android:paddingTop="@dimen/cv_space_sm"
            android:paddingBottom="@dimen/cv_space_xl"
            android:scrollbars="vertical" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
