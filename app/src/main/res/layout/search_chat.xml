<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_vault_screen">

    <!-- Search Header -->
    <LinearLayout
        android:id="@+id/searchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_vault_panel_soft"
        android:padding="@dimen/cv_space_lg">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_vault_message_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/cv_space_md">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/cv_text_secondary_dark"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/cv_space_md"
                android:layout_marginEnd="@dimen/cv_space_md"
                android:hint="Search messages..."
                android:textSize="16sp"
                android:textColor="@color/cv_text_primary_dark"
                android:textColorHint="@color/cv_text_secondary_dark"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@android:color/transparent"
                app:tint="@color/cv_text_secondary_dark"
                android:contentDescription="Clear search"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cv_space_md"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/filterChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="@dimen/cv_space_lg" />
        </HorizontalScrollView>

        <!-- Search Stats -->
        <TextView
            android:id="@+id/tvSearchStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cv_space_sm"
            android:textSize="12sp"
            android:textColor="@color/cv_text_secondary_dark"
            android:text="" />
    </LinearLayout>

    <!-- Results List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/cv_space_md"
        android:paddingVertical="@dimen/cv_space_md"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="48sp"
            android:layout_marginBottom="@dimen/cv_space_lg" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No messages found"
            android:textSize="16sp"
            android:textColor="@color/cv_text_secondary_dark"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try a different search term"
            android:textSize="13sp"
            android:textColor="@color/cv_text_tertiary_dark"
            android:layout_marginTop="@dimen/cv_space_sm"
            android:gravity="center" />
    </LinearLayout>

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Searching..."
            android:textSize="14sp"
            android:textColor="@color/cv_text_secondary_dark"
            android:layout_marginTop="@dimen/cv_space_lg" />
    </LinearLayout>

</LinearLayout>
