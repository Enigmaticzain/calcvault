<?xml version="1.0" encoding="utf-8"?>
<!--
  data_extraction_rules.xml
  Blocks ALL Android Backup, Google Drive backup, and D2D transfer.
  CalcVault data must NEVER leave the device via system backup —
  it lives only on the USB drive.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
